# Discord bot token (required) — from the Discord developer portal
DISCORD_BOT_TOKEN=

# Port for the HTTP API consumed by the frontend (default: 5001)
PORT=5001

# OpenTheta API base URL (default: https://api.opentheta.io/v1/)
API_BASE_URL=https://api.opentheta.io/v1/

# Base URL of the verification frontend the bot links users to
# (default: https://opentheta.io/thetaguard/)
# VERIFY_BASE_URL=https://opentheta.io/thetaguard/

# How often the full role sync runs, in milliseconds (default: 300000 = 5min)
# SYNC_INTERVAL_MS=300000

# Comma-separated list of allowed CORS origins for the API.
# Unset = wildcard (*), the historic behavior the deployed frontend relies on.
# CORS_ORIGINS=https://opentheta.io

# API rate limit per IP (defaults: 300 requests per 60000 ms)
# RATE_LIMIT_MAX=300
# RATE_LIMIT_WINDOW_MS=60000

# Log level: fatal | error | warn | info | debug | trace (default: info)
# LOG_LEVEL=info

# Path to the SQLite database file (default: ./db/ThetaGuard.db)
# In production this lives on the mounted db/ volume — do not change.
# DB_FILE=./db/ThetaGuard.db
